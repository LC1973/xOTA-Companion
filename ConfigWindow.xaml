<Window x:Class="xOTACompanion.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:xOTACompanion"
        xmlns:wc="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings – xOTA Companion"
        Height="640" Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource DarkPanel}"
        BorderThickness="1" BorderBrush="{StaticResource DarkBorder}"
        AllowsTransparency="True">

    <wc:WindowChrome.WindowChrome>
        <wc:WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </wc:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#FF2D2D30" BorderThickness="0,0,0,1" BorderBrush="#FF3E3E42"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="⚙  Settings" Foreground="{StaticResource DarkText}" FontSize="{StaticResource TitleFontSize}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0"/>
                <Button Grid.Column="1" Content="✕" Width="40" Height="32" Background="Transparent"
                        Foreground="{StaticResource DarkTextSecondary}" BorderThickness="0"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource CloseButtonRed}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Settings content -->
        <ScrollViewer Grid.Row="1" Margin="16">
            <StackPanel local:SP.Gap="12">
                <TextBlock Text="AUTO-REFRESH INTERVAL" Foreground="{StaticResource DarkTextSecondary}"
                           FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" local:SP.Gap="8">
                    <TextBox x:Name="RefreshBox" Style="{StaticResource DarkTextBox}" Width="60" Text="2"/>
                    <TextBlock Text="minutes  (0 = manual only)" Foreground="{StaticResource DarkTextSecondary}"
                               VerticalAlignment="Center" FontSize="{StaticResource ContentFontSize}"/>
                </StackPanel>

                <Separator Background="{StaticResource DataGridGridLines}" Margin="0,4"/>

                <TextBlock Text="SOURCES TO SHOW" Foreground="{StaticResource DarkTextSecondary}"
                           FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"/>
                <CheckBox x:Name="ShowPotaCheck" Content="POTA  (Parks on the Air)" Style="{StaticResource DarkCheckBox}"/>
                <CheckBox x:Name="ShowSotaCheck" Content="SOTA  (Summits on the Air)" Style="{StaticResource DarkCheckBox}"/>

                <Separator Background="{StaticResource DataGridGridLines}" Margin="0,4"/>

                <TextBlock Text="DISTANCE UNIT" Foreground="{StaticResource DarkTextSecondary}"
                           FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" local:SP.Gap="16">
                    <RadioButton x:Name="KmRadio" Content="Kilometres" Foreground="{StaticResource DarkText}"
                                 FontSize="{StaticResource ContentFontSize}" GroupName="dist"/>
                    <RadioButton x:Name="MiRadio" Content="Miles" Foreground="{StaticResource DarkText}"
                                 FontSize="{StaticResource ContentFontSize}" GroupName="dist"/>
                </StackPanel>

                <!-- ── Manual station config (shown when GreenLogger is not available) ── -->
                <StackPanel x:Name="StationSection" Visibility="Collapsed" local:SP.Gap="8">
                    <Separator Background="{StaticResource DataGridGridLines}" Margin="0,4"/>
                    <TextBlock Text="YOUR STATION" Foreground="{StaticResource DarkTextSecondary}"
                               FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" local:SP.Gap="8">
                        <TextBlock Text="Callsign" Width="70" Foreground="{StaticResource DarkText}"
                                   FontSize="{StaticResource ContentFontSize}" VerticalAlignment="Center"/>
                        <TextBox x:Name="MyCallsignBox" Style="{StaticResource DarkTextBox}" Width="120"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" local:SP.Gap="8">
                        <TextBlock Text="Locator" Width="70" Foreground="{StaticResource DarkText}"
                                   FontSize="{StaticResource ContentFontSize}" VerticalAlignment="Center"/>
                        <TextBox x:Name="MyLocatorBox" Style="{StaticResource DarkTextBox}" Width="120"/>
                        <TextBlock Text="(Maidenhead, e.g. IO91wm)" Foreground="{StaticResource DarkTextSecondary}"
                                   FontSize="{StaticResource SmallFontSize}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Radio list (shown when GreenLogger is not available) ──────────── -->
                <StackPanel x:Name="RadiosSection" Visibility="Collapsed" local:SP.Gap="8">
                    <Separator Background="{StaticResource DataGridGridLines}" Margin="0,4"/>
                    <TextBlock Text="RADIOS" Foreground="{StaticResource DarkTextSecondary}"
                               FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"/>
                    <ListBox x:Name="RadioListBox" Height="110"
                             Background="{StaticResource InputBackground}"
                             BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                             Foreground="{StaticResource DarkText}"
                             FontSize="{StaticResource ContentFontSize}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectionHighlight}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DarkBorder}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" local:SP.Gap="6">
                        <Button Content="+ Add"  Style="{StaticResource SecondaryButton}" Width="64" Click="AddRadio_Click"/>
                        <Button Content="Edit"   Style="{StaticResource SecondaryButton}" Width="64" Click="EditRadio_Click"/>
                        <Button Content="Remove" Style="{StaticResource DangerButton}"    Width="72" Click="RemoveRadio_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ── Operators / SOTA Keys ─────────────────────────────────────── -->
                <StackPanel x:Name="OperatorsSection" local:SP.Gap="8">
                    <Separator Background="{StaticResource DataGridGridLines}" Margin="0,4"/>
                    <TextBlock Text="OPERATORS / SOTA KEYS" Foreground="{StaticResource DarkTextSecondary}"
                               FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"/>
                    <ListBox x:Name="OperatorListBox" Height="90"
                             Background="{StaticResource InputBackground}"
                             BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                             Foreground="{StaticResource DarkText}"
                             FontSize="{StaticResource ContentFontSize}"
                             SelectionChanged="OperatorListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{StaticResource DarkText}"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectionHighlight}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DarkBorder}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <Button x:Name="EditSotaKeyButton" Content="Edit SOTA Key\u2026"
                            Style="{StaticResource SecondaryButton}" Width="120" HorizontalAlignment="Left"
                            IsEnabled="False" Click="EditOperator_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="16,0,16,16" local:SP.Gap="8">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="80" Click="Close_Click"/>
            <Button Content="Save" Style="{StaticResource DarkButton}" Width="80" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
