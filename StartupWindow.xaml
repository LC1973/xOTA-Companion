<Window x:Class="xOTACompanion.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xOTA Companion"
        Height="310"
        Width="460"
        MinHeight="290"
        MinWidth="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{DynamicResource DarkBackground}"
        Foreground="{DynamicResource DarkText}">

    <Border BorderBrush="#FF3E3E42" BorderThickness="1" CornerRadius="6"
            Background="{DynamicResource DarkBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <DockPanel Grid.Row="0" Background="{DynamicResource DarkSurface}" Height="40"
                       LastChildFill="True" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="&#x1F4FB;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="xOTA Companion" FontWeight="Bold" FontSize="14"
                               Foreground="{DynamicResource DarkText}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Subtitle -->
                <TextBlock x:Name="SubtitleText"
                           Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,0,0,14"
                           Text="Confirm your operator and radio for this session."
                           Foreground="{DynamicResource DarkTextSecondary}"
                           FontSize="13"/>

                <!-- Operator -->
                <TextBlock x:Name="OperatorLabelText"
                           Grid.Row="1" Grid.Column="0"
                           Margin="0,0,10,8" VerticalAlignment="Center"
                           Text="Operator"
                           Foreground="{DynamicResource DarkText}"/>
                <ComboBox x:Name="OperatorCombo"
                          Grid.Row="1" Grid.Column="1"
                          Margin="0,0,0,8"
                          Style="{DynamicResource DarkComboBox}"
                          SelectionChanged="OperatorCombo_SelectionChanged"/>

                <!-- SOTA key (hidden – managed in Settings) -->
                <TextBlock x:Name="SotaKeyLabel"
                           Grid.Row="2" Grid.Column="0"
                           Visibility="Collapsed"
                           Margin="0,0,10,8" VerticalAlignment="Center"
                           Text="SOTA key"
                           Foreground="{DynamicResource DarkText}"/>
                <TextBlock x:Name="SotaKeyText" Grid.Row="2" Grid.Column="1"
                           Visibility="Collapsed"
                           Margin="0,0,0,8" VerticalAlignment="Center"
                           Text="&#x2013;"
                           Foreground="{DynamicResource DarkTextSecondary}"
                           FontSize="12" FontFamily="Consolas"/>

                <!-- Radio -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0,0,10,8" VerticalAlignment="Center"
                           Text="Radio"
                           Foreground="{DynamicResource DarkText}"/>
                <ComboBox x:Name="RadioCombo"
                          Grid.Row="3" Grid.Column="1"
                          Margin="0,0,0,8"
                          Style="{DynamicResource DarkComboBox}"
                          SelectionChanged="RadioCombo_SelectionChanged"/>

                <!-- Radio connection info -->
                <TextBlock x:Name="RadioInfoText"
                           Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource DarkTextSecondary}"
                           FontSize="11"
                           Text=""/>

                <!-- Buttons -->
                <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <Button Content="&#x2699;  Settings"
                            Width="90" Height="32"
                            HorizontalAlignment="Left"
                            Click="Settings_Click"
                            Style="{DynamicResource DarkButton}"
                            Background="{DynamicResource MutedButtonBg}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Width="90" Height="32"
                                Margin="0,0,10,0"
                                Click="Cancel_Click"
                                Style="{DynamicResource DarkButton}"
                                Background="{DynamicResource MutedButtonBg}"/>
                        <Button Content="&#x25B6;  Start"
                                Width="110" Height="32"
                                Click="Start_Click"
                                Style="{DynamicResource DarkButton}"
                                IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
