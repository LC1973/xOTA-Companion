<Window x:Class="xOTACompanion.MapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:xOTACompanion"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wc="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Spot Map"
        Height="680" Width="900"
        MinHeight="480" MinWidth="600"
        Background="{StaticResource DarkBackground}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="1"
        BorderBrush="{StaticResource DarkBorder}"
        AllowsTransparency="True">

    <wc:WindowChrome.WindowChrome>
        <wc:WindowChrome CaptionHeight="36" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </wc:WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Border Grid.Row="0" Background="#FF2D2D30" BorderThickness="0,0,0,1" BorderBrush="#FF3E3E42"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="📍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="Spot Map" Foreground="{StaticResource DarkText}"
                               FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="40" Height="32"
                        Background="Transparent" Foreground="{StaticResource DarkTextSecondary}"
                        BorderThickness="0" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource CloseButtonRed}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Map Content -->
        <Grid Grid.Row="1">
            <Border x:Name="LoadingPanel" Background="#FF1E1E1E" Panel.ZIndex="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🗺️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock x:Name="LoadingText" Text="Loading map..." Foreground="{StaticResource DarkTextSecondary}"
                               FontSize="16" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <wv2:WebView2 x:Name="MapWebView" DefaultBackgroundColor="Transparent" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
