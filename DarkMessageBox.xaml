<Window x:Class="xOTACompanion.DarkMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:xOTACompanion"
        xmlns:wc="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="xOTA Companion"
        SizeToContent="WidthAndHeight"
        MinWidth="320" MaxWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource DarkPanel}"
        BorderThickness="1"
        BorderBrush="{StaticResource DarkBorder}"
        AllowsTransparency="True">

    <wc:WindowChrome.WindowChrome>
        <wc:WindowChrome CaptionHeight="32" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </wc:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#FF2D2D30">
            <TextBlock x:Name="TitleText" Text="xOTA Companion" Foreground="{StaticResource DarkText}"
                       FontSize="{StaticResource TitleFontSize}" VerticalAlignment="Center" Margin="12,0"/>
        </Border>

        <!-- Message -->
        <StackPanel Grid.Row="1" Margin="20,16" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="IconText" FontSize="28" VerticalAlignment="Top" Margin="0,0,12,0"/>
            <TextBlock x:Name="MessageText" Foreground="{StaticResource DarkText}"
                       FontSize="{StaticResource ContentFontSize}"
                       TextWrapping="Wrap" MaxWidth="420"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="16,0,16,16" local:SP.Gap="8">
            <Button x:Name="YesButton" Content="Yes" Width="80" Style="{StaticResource DarkButton}" Click="YesButton_Click" Visibility="Collapsed"/>
            <Button x:Name="NoButton" Content="No" Width="80" Style="{StaticResource SecondaryButton}" Click="NoButton_Click" Visibility="Collapsed"/>
            <Button x:Name="OkButton" Content="OK" Width="80" Style="{StaticResource DarkButton}" IsDefault="True" Click="OkButton_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="CancelButton_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>
