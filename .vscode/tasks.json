{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Deploy xOTA Companion",
			"type": "shell",
			"command": "Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned; & '${workspaceFolder}\\deploy.ps1'",
			"options": {
				"shell": {
					"executable": "powershell.exe",
					"args": [
						"-NoProfile",
						"-Command"
					]
				}
			},
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Build xOTA Companion",
			"type": "shell",
			"command": "dotnet build xOTACompanion.sln --configuration Release",
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}